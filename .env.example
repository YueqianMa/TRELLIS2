# ==============================================================================
# TRELLIS RunPod Serverless - Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# Storage Backend Configuration
# Options: 'base64', 's3', 'runpod'
# Default: 'base64' (returns files as base64 encoded strings)
# ------------------------------------------------------------------------------
STORAGE_BACKEND=base64

# ------------------------------------------------------------------------------
# S3/R2/MinIO Storage Configuration (if STORAGE_BACKEND=s3)
# Works with AWS S3, Cloudflare R2, MinIO, and other S3-compatible services
# ------------------------------------------------------------------------------

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name

# For Cloudflare R2 or other S3-compatible services
# S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# Public URL base for generating accessible URLs (optional)
# S3_PUBLIC_URL_BASE=https://your-bucket.your-domain.com

# ------------------------------------------------------------------------------
# Model Configuration
# ------------------------------------------------------------------------------

# Whether to preload model on startup (reduces first request latency)
PRELOAD_MODEL=true

# Attention backend: 'xformers' or 'flash-attn'
ATTN_BACKEND=flash-attn

# Sparse convolution algorithm
SPCONV_ALGO=native

# ------------------------------------------------------------------------------
# Hugging Face Configuration (for private models, optional)
# ------------------------------------------------------------------------------
# HF_TOKEN=your_huggingface_token_here

# ------------------------------------------------------------------------------
# RunPod Configuration
# ------------------------------------------------------------------------------
# RUNPOD_API_KEY=your_runpod_api_key_here
